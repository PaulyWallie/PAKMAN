<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi:schemaLocation="UnityEngine.UIElements ../../UIElementsSchema/UnityEngine.UIElements.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ui:Style src="Styles/PAKMAN_Styles.uss" />
    <ui:VisualElement name="screenRoot" class="screen-root">
        <ui:VisualElement name="menuContainer" class="menu-container">
            <ui:Label name="title" text="PAKMAN" class="menu-title" />
            <ui:Button name="newGameButton" text="New Game" class="menu-button" />
            <ui:Button name="continueButton" text="Continue" class="menu-button" />
            <ui:Button name="quitButton" text="Quit" class="menu-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
