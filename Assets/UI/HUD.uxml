<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="Styles/PAKMAN_Styles.uss" />
    <ui:VisualElement class="hud-overlay-root" picking-mode="Ignore">
        <ui:VisualElement name="hudRoot" class="hud-root" picking-mode="Ignore">
            <ui:VisualElement name="leftContainer" picking-mode="Ignore">
                <ui:VisualElement class="hud-stat-container" picking-mode="Ignore"><ui:Label name="coinLabel" text="Coins: 0" class="hud-label" /></ui:VisualElement>
                <ui:VisualElement class="hud-stat-container" picking-mode="Ignore"><ui:Label name="skullLabel" text="Skulls: 0" class="hud-label" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="rightContainer" picking-mode="Ignore">
                <ui:VisualElement name="heartContainer" class="heart-container" picking-mode="Ignore">
                    <ui:VisualElement name="heart1" class="heart-slot" picking-mode="Ignore"><ui:Image class="heart-image heart-depleted" picking-mode="Ignore" /><ui:VisualElement class="heart-fill" picking-mode="Ignore"><ui:Image class="heart-image" picking-mode="Ignore" /></ui:VisualElement></ui:VisualElement>
                    <ui:VisualElement name="heart2" class="heart-slot" picking-mode="Ignore"><ui:Image class="heart-image heart-depleted" picking-mode="Ignore" /><ui:VisualElement class="heart-fill" picking-mode="Ignore"><ui:Image class="heart-image" picking-mode="Ignore" /></ui:VisualElement></ui:VisualElement>
                    <ui:VisualElement name="heart3" class="heart-slot" picking-mode="Ignore"><ui:Image class="heart-image heart-depleted" picking-mode="Ignore" /><ui:VisualElement class="heart-fill" picking-mode="Ignore"><ui:Image class="heart-image" picking-mode="Ignore" /></ui:VisualElement></ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="lives-container" picking-mode="Ignore"><ui:Image name="playerLivesIcon" class="player-lives-icon" picking-mode="Ignore" /><ui:Label name="livesLabel" text="× 3" class="hud-label" /></ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="upgradePopupLayer" class="upgrade-popup-layer" picking-mode="Ignore"><ui:Label name="upgradeUnlockedLabel" text="Upgrade unlocked" class="upgrade-popup upgrade-popup-hidden" picking-mode="Ignore" /></ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
